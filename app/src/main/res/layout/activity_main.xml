<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/preview_surface">
    <include layout="@layout/browse_shell" />
    <LinearLayout android:id="@+id/arena_screen" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
        <LinearLayout android:id="@+id/arena_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingHorizontal="12dp">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/venue_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:id="@+id/venue_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:maxLines="2" />
            </LinearLayout>
            <Button android:id="@+id/show_games" android:layout_width="wrap_content" android:layout_height="56dp" android:text="@string/change_match" android:textSize="12sp" />
        </LinearLayout>
        <androidx.coordinatorlayout.widget.CoordinatorLayout android:id="@+id/arena_stage" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
            <Spinner android:visibility="gone" android:id="@+id/level_filter" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:contentDescription="@string/filter_level" />
            <Spinner android:visibility="gone" android:id="@+id/section_filter" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:contentDescription="@string/filter_section" />
            <Spinner android:id="@+id/type_filter" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:contentDescription="@string/ticket_type" />
            <Spinner android:id="@+id/budget_filter" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:contentDescription="@string/ticket_budget" />
            <Button android:id="@+id/clear_filter" android:layout_width="48dp" android:layout_height="48dp" android:text="@string/clear_filter_short" android:contentDescription="@string/clear_filter" android:padding="0dp" />
            <Button android:id="@+id/reset_view" android:layout_width="80dp" android:layout_height="48dp" android:text="@string/reset_view" android:padding="0dp" android:textSize="12sp" />
        </LinearLayout>
        <TextView android:id="@+id/preview_status" android:layout_width="match_parent" android:layout_height="28dp" android:textSize="11sp" android:paddingHorizontal="12dp" android:textColor="@color/preview_text" android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/status_legend" android:layout_width="match_parent" android:layout_height="28dp" android:textSize="11sp" android:paddingHorizontal="12dp" android:textColor="@color/preview_text" />
        <TextView android:id="@+id/tier_legend" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
            <com.example.nbatickethub.ui.arena.ArenaView android:id="@+id/arena_view" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingBottom="64dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/seat_sheet" android:layout_width="match_parent" android:layout_height="440dp" android:layout_gravity="top|end" android:orientation="vertical" android:background="#FFFFFF" android:elevation="10dp" app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior" app:behavior_peekHeight="64dp" app:behavior_fitToContents="true">
                <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:paddingHorizontal="12dp">
                    <TextView android:id="@+id/selection_summary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="15sp" android:textStyle="bold" android:textColor="#10283F" />
                    <Button android:id="@+id/cancel_change" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/cancel_change" android:visibility="gone" android:textSize="12sp" />
                    <Button android:id="@+id/toggle_sheet" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/details" android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/ticket_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
                <ListView android:id="@+id/selected_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:dividerHeight="1dp" android:background="#FFFFFF" android:contentDescription="@string/section_tickets" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:paddingHorizontal="8dp" android:gravity="center_vertical">
                    <Button android:id="@+id/change_seat" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="@string/change_seat" />
                    <Button android:id="@+id/toggle_seat" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="@string/confirm_seat" />
                </LinearLayout>
            </LinearLayout>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </LinearLayout>
</LinearLayout>
