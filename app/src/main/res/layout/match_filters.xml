<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/preview_surface" android:padding="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp">
        <Button android:id="@+id/match_seven_days" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="@string/next_seven_days" android:textSize="13sp" />
        <Button android:id="@+id/match_today" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="@string/match_today" android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp">
        <Button android:id="@+id/match_date" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="@string/pick_match_day" android:textSize="13sp" />
        <Button android:id="@+id/match_clear" android:layout_width="88dp" android:layout_height="48dp" android:text="@string/clear_filter" android:textSize="13sp" />
    </LinearLayout>
    <Button android:id="@+id/match_team" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/all_teams" android:gravity="center_vertical|start" android:drawablePadding="12dp" android:textSize="14sp" />
    <CheckBox android:id="@+id/match_home_only" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/home_only" android:visibility="gone" android:textColor="@color/preview_text" />
    <TextView android:id="@+id/match_filter_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="8dp" android:textSize="12sp" android:textColor="@color/preview_muted" android:accessibilityLiveRegion="polite" />
    <TextView android:id="@+id/match_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="24dp" android:text="@string/no_matching_games" android:textSize="16sp" android:textColor="@color/preview_text" android:visibility="gone" />
</LinearLayout>