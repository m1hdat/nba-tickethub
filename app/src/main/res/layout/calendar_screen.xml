<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/game_picker" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/browse_background" android:saveEnabled="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nav_schedule" android:textSize="30sp" android:textStyle="bold" android:fontFamily="sans-serif-condensed" android:textColor="@color/browse_text" android:paddingVertical="20dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sample_notice" android:textColor="@color/browse_muted" android:paddingBottom="20dp" />
            <include layout="@layout/match_filters" />
            <LinearLayout android:id="@+id/game_cards" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
