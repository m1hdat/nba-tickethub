<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/browse_shell" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/browse_background">
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ScrollView android:id="@+id/browse_home" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView style="@style/BrowseEyebrow" android:text="@string/browse_brand" />
                <TextView style="@style/BrowseHeading" android:text="@string/browse_headline" />
                <LinearLayout android:id="@+id/featured_match" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                <TextView style="@style/BrowseHeading" android:text="@string/browse_upcoming" />
                <LinearLayout android:id="@+id/upcoming_matches" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                <Button android:id="@+id/browse_all_matches" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/browse_all_matches" />
                <TextView style="@style/BrowseHeading" android:text="@string/browse_explore_teams" />
                <LinearLayout android:id="@+id/home_teams" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                <TextView style="@style/BrowseEyebrow" android:text="@string/browse_mock_notice" />
            </LinearLayout>
        </ScrollView>
        <include layout="@layout/calendar_screen" />
        <ScrollView android:id="@+id/browse_teams" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView style="@style/BrowseEyebrow" android:text="@string/browse_brand" />
                <TextView style="@style/BrowseHeading" android:text="@string/nav_teams" />
                <TextView style="@style/BrowseEyebrow" android:text="@string/browse_team_hint" />
                <LinearLayout android:id="@+id/browse_team_grid" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
        <LinearLayout android:id="@+id/browse_detail" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
            <Button android:id="@+id/detail_back" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/browse_back" android:backgroundTint="@android:color/transparent" android:textColor="@color/browse_text" />
            <ScrollView android:id="@+id/detail_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView style="@style/BrowseHeading" android:text="@string/browse_detail_title" />
                    <LinearLayout android:id="@+id/detail_poster" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                    <TextView style="@style/BrowseEyebrow" android:text="@string/browse_detail_hint" />
                </LinearLayout>
            </ScrollView>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="12dp" android:background="@color/browse_surface">
                <TextView android:id="@+id/detail_price" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/browse_text" android:textSize="18sp" android:textStyle="bold" />
                <Button android:id="@+id/detail_choose_seats" android:layout_width="wrap_content" android:layout_height="56dp" android:minWidth="144dp" android:text="@string/browse_choose_seats" android:backgroundTint="@color/browse_accent" android:textColor="@color/browse_background" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout android:id="@+id/browse_nav" android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:background="@color/browse_surface">
        <Button android:id="@+id/nav_home" style="@style/BrowseNav" android:text="@string/nav_home" />
        <Button android:id="@+id/nav_schedule" style="@style/BrowseNav" android:text="@string/nav_schedule" />
        <Button android:id="@+id/nav_teams" style="@style/BrowseNav" android:text="@string/nav_teams" />
    </LinearLayout>
</LinearLayout>
