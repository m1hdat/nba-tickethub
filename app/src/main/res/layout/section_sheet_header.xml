<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/seat_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="12dp" android:paddingVertical="4dp" android:maxLines="1" android:ellipsize="end" android:textSize="14sp" android:textStyle="bold" android:textColor="#10283F" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="12dp" android:paddingBottom="6dp" android:text="@string/simulated_view" android:textSize="12sp" android:textColor="#526779" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
    <com.example.nbatickethub.ui.arena.SeatPerspectiveView android:id="@+id/seat_perspective" android:layout_width="match_parent" android:layout_height="200dp" android:contentDescription="@string/open_simulated_view" android:clickable="true" android:focusable="true" />
        <Button android:id="@+id/fullscreen_view" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_gravity="end|top" android:text="@string/details" android:contentDescription="@string/open_simulated_view" />
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:paddingHorizontal="12dp" android:gravity="center_vertical">
        <TextView android:id="@+id/selection_outside" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#526779" />
        <Button android:id="@+id/clear_selection" android:layout_width="wrap_content" android:layout_height="32dp" android:text="@string/clear_selection" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>