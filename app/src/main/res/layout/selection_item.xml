<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
    android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/selection_item_text" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/preview_text"
        android:paddingVertical="8dp" android:paddingEnd="8dp" />
    <Button android:id="@+id/selection_item_remove" android:layout_width="64dp" android:layout_height="48dp"
        android:text="@string/remove_seat" android:textSize="12sp" android:focusable="false" />
</LinearLayout>
